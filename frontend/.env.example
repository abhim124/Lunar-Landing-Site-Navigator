# Optional. The app runs with no .env.local at all.

# Mission backend URL (default http://localhost:8000).
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Hadfield (the assistant). Leave unset to use the hosted relay, which needs no key from you.
# Set your own key to call Claude directly (server-side only; never prefix with NEXT_PUBLIC_).
# ANTHROPIC_API_KEY=
# HADFIELD_RELAY_URL=https://lunar-landing-site-navigator-one.vercel.app

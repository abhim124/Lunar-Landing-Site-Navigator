# Phase 1 FastAPI backend (must enable CORS for the Next.js origin)
NEXT_PUBLIC_API_BASE=http://localhost:8000


# Hadfield assistant via OpenRouter (server-side only, read by src/app/api/assistant/route.ts; never prefix with NEXT_PUBLIC_)
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: comma-separated model list (default: free Gemma 4 31B, then free Nemotron, then OpenRouter's free router)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
